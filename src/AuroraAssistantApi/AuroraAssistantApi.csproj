<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AuroraAssistantApi</AssemblyName>
    <Version>0.1.0</Version>
    <RootNamespace>AuroraAssistantApi</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Aurora install (with AuroraPatch and Lib) used for references and deployment:
         dotnet build -p:AuroraDir=... or an AuroraDir environment variable. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="AuroraPatch">
      <HintPath>$(AuroraDir)/AuroraPatch.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(AuroraDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(AuroraDir)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lib">
      <HintPath>$(AuroraDir)/Patches/Lib/Lib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckAuroraDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(AuroraDir)' == '' Or !Exists('$(AuroraDir)/AuroraPatch.exe')"
           Text="Set AuroraDir to an Aurora folder with AuroraPatch and Lib installed (e.g. dotnet build -p:AuroraDir=C:\Games\Aurora)." />
  </Target>

  <!-- dotnet build -t:Deploy : copy the patch into Aurora's Patches folder. -->
  <Target Name="Deploy" DependsOnTargets="Build">
    <MakeDir Directories="$(AuroraDir)/Patches/AuroraAssistantApi" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(AuroraDir)/Patches/AuroraAssistantApi" />
  </Target>

</Project>
